{
  "id": "review-loop",
  "inputs": {
    "brief": "inputs/brief.md"
  },
  "steps": [
    {
      "id": "draft",
      "kind": "llm",
      "role": "roles/writer.md",
      "inputs": [
        "brief"
      ],
      "output": "draft",
      "route": "fast",
      "next": [
        "critic"
      ]
    },
    {
      "id": "critic",
      "kind": "llm",
      "role": "roles/reviewer.md",
      "inputs": [
        "draft"
      ],
      "output": "critique",
      "route": "quality",
      "next": [
        "gate"
      ]
    },
    {
      "id": "gate",
      "kind": "decide",
      "source": "critique",
      "cases": [
        {
          "when": [
            "PASS"
          ],
          "goto": "done"
        },
        {
          "when": [
            "FAIL"
          ],
          "goto": "revise",
          "max": 3
        }
      ]
    },
    {
      "id": "revise",
      "kind": "llm",
      "role": "roles/reviser.md",
      "inputs": [
        "draft",
        "critique"
      ],
      "output": "draft",
      "route": "fast",
      "next": [
        "critic"
      ]
    },
    {
      "id": "done",
      "kind": "exec",
      "argv": [
        "node",
        "scripts/finish.js"
      ],
      "inputs": [
        "draft"
      ],
      "outputs": [
        "receipt"
      ],
      "next": []
    }
  ]
}
