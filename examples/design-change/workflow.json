{
  "id": "design-change",
  "inputs": {
    "request": "inputs/request.md",
    "style": "inputs/style.md"
  },
  "steps": [
    {
      "id": "plan",
      "kind": "llm",
      "role": "roles/planner.md",
      "inputs": [
        "request",
        "style"
      ],
      "output": "design-plan",
      "route": "planning",
      "next": [
        "plan-review"
      ]
    },
    {
      "id": "plan-review",
      "kind": "llm",
      "role": "roles/plan-reviewer.md",
      "inputs": [
        "design-plan"
      ],
      "output": "plan-verdict",
      "route": "review",
      "next": [
        "plan-gate"
      ]
    },
    {
      "id": "plan-gate",
      "kind": "decide",
      "source": "plan-verdict",
      "cases": [
        {
          "when": [
            "PASS"
          ],
          "goto": "implement"
        },
        {
          "when": [
            "FAIL"
          ],
          "goto": "plan-revise",
          "max": 3
        }
      ]
    },
    {
      "id": "plan-revise",
      "kind": "llm",
      "role": "roles/planner.md",
      "inputs": [
        "design-plan",
        "plan-verdict"
      ],
      "output": "design-plan",
      "route": "planning",
      "next": [
        "plan-review"
      ]
    },
    {
      "id": "implement",
      "kind": "llm",
      "role": "roles/implementer.md",
      "inputs": [
        "design-plan"
      ],
      "output": "implementation",
      "route": "coding-agent",
      "next": [
        "screenshot"
      ]
    },
    {
      "id": "screenshot",
      "kind": "exec",
      "argv": [
        "node",
        "scripts/capture.js"
      ],
      "inputs": [
        "implementation"
      ],
      "outputs": [
        "screenshots"
      ],
      "next": [
        "visual-review"
      ]
    },
    {
      "id": "visual-review",
      "kind": "llm",
      "role": "roles/visual-reviewer.md",
      "inputs": [
        "screenshots",
        "style"
      ],
      "output": "visual-verdict",
      "route": "review",
      "next": [
        "visual-gate"
      ]
    },
    {
      "id": "visual-gate",
      "kind": "decide",
      "source": "visual-verdict",
      "cases": [
        {
          "when": [
            "PASS"
          ],
          "goto": "reader-check"
        },
        {
          "when": [
            "FAIL"
          ],
          "goto": "implement",
          "max": 3
        }
      ]
    },
    {
      "id": "reader-check",
      "kind": "llm",
      "role": "roles/reader.md",
      "inputs": [
        "implementation"
      ],
      "output": "reader-verdict",
      "route": "review",
      "next": [
        "reader-gate"
      ]
    },
    {
      "id": "reader-gate",
      "kind": "decide",
      "source": "reader-verdict",
      "cases": [
        {
          "when": [
            "PASS"
          ],
          "goto": "done"
        },
        {
          "when": [
            "FAIL"
          ],
          "goto": "implement",
          "max": 3
        }
      ]
    },
    {
      "id": "done",
      "kind": "exec",
      "argv": [
        "node",
        "scripts/finish.js"
      ],
      "inputs": [
        "implementation"
      ],
      "outputs": [
        "receipt"
      ],
      "next": [],
      "waitFor": [
        "reader-check"
      ]
    }
  ]
}
